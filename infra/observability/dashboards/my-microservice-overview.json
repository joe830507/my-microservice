    {
      "id": 20,
      "type": "row",
      "title": "Log（warn、error）",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 21,
      "type": "logs",
      "title": "warn / error",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "{service_name=~\".+\"} | detected_level=~\"warn|error\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "description": "服務的 RED 指標、業務數字、排程、資源與 warn/error log。log 與追蹤互通：在 Explore 用 trace_id 查。"
}
