          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (service_name) (increase(tasks_scheduled_execution_milliseconds_count{outcome!=\"SUCCESS\"}[5m]))",
          "legendFormat": "失敗 {{service_name}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
