        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "資料庫連線（使用中 / 等待中）",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 31,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "使用中 {{service_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "hikaricp_connections_pending",
          "legendFormat": "等待 {{service_name}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
