{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "InventoryServiceApplication",
      "request": "launch",
      "mainClass": "com.mymicroservice.inventory.InventoryServiceApplication",
      "projectName": "inventory-service"
    },
    {
      "type": "java",
      "name": "user-service (dev)",
      "request": "launch",
      "mainClass": "com.mymicroservice.user.UserServiceApplication",
      "projectName": "user-service",
      "cwd": "${workspaceFolder}/backend/spring-user-service",
      "args": "--spring.profiles.active=dev",
      "envFile": "${workspaceFolder}/backend/spring-user-service/secrets/dev.env"
    }
  ]
}
