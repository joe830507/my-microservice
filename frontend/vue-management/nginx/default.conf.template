server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 不回報 nginx 版本
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # 經過 nginx 的只有 API 的 JSON，上限 1m 綽綽有餘；圖片是瀏覽器直接上傳到物件儲存，不經過這裡
    client_max_body_size 1m;

    # 安全標頭在每個 location 裡各自 include（add_header 不會從 server 層繼承到有自己 add_header 的 location，
    # 反過來 server 層也 include 的話，沒有 add_header 的 location 會輸出兩份）

    # K8s 的存活、就緒探針用
    location = /healthz {
        access_log off;
        default_type text/plain;
        include /etc/nginx/conf.d/security-headers.inc;
        return 200 "ok\n";
    }

    # API：proxy_pass 的主機名稱在 nginx 啟動時解析，後端的 Service 還沒建好時 nginx 會啟動失敗，
    # K8s 會自動重啟直到解析得到，探針沒通過之前也不會有流量進來
    # 只轉發 /api/v1/ 開頭的路徑到 api-gateway（路徑原樣保留，Gateway 本來就是 /api/v1/...）
    # 其他 /api 底下的路徑（例如 /api/actuator）不轉發，直接 404
    location /api/v1/ {
        proxy_pass ${API_GATEWAY_URL};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        # 覆蓋而不是附加：用戶端自己帶的 X-Forwarded-For 不可信，否則依 IP 的登入限流可以被偽造
        # （前面如果還有 Ingress，這裡要改成信任 Ingress 傳來的值，見 docs/security/known-issues.md）
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 身分 header 只能由 api-gateway 在驗過 JWT 後產生；這裡再清一次，多一層防線
        proxy_set_header X-User-Id "";
        proxy_set_header X-User-Roles "";

        # 前端 axios 的逾時是 30 秒
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;

        include /etc/nginx/conf.d/security-headers.inc;
    }

    location /api/ {
        default_type application/json;
        include /etc/nginx/conf.d/security-headers.inc;
        return 404 '{"status":404,"code":"NOT_FOUND","detail":"not found"}';
    }

    # 打包後的檔名帶雜湊，內容不變，可以長期快取
    location /assets/ {
        try_files $uri =404;
        # 不用 expires：它會另外輸出一個 Cache-Control，和這個重複
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # index.html 每次都要重新驗證，否則發布新版後使用者拿到的還是指向舊檔名的 index.html
    location = /index.html {
        add_header Cache-Control "no-cache";
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # SPA：找不到實體檔案的路徑（/p/123、/orders 等）都回 index.html，由前端路由處理
    # 前端路由的 404 頁由 vue-router 顯示，這裡不回 404
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/conf.d/security-headers.inc;
    }
}
