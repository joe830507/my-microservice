{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "smartcn": {
          "type": "smartcn"
        }
      },
      "normalizer": {
        "sku_lowercase": {
          "type": "custom",
          "filter": ["lowercase"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "_meta": {
      "schemaVersion": 1,
      "built": false
    },
    "properties": {
      "id": { "type": "keyword" },
      "sku": { "type": "keyword", "normalizer": "sku_lowercase" },
      "name": {
        "type": "text",
        "analyzer": "smartcn",
        "fields": {
          "char": { "type": "text", "analyzer": "standard" },
          "raw": { "type": "keyword" }
        }
      },
      "brand": { "type": "text", "analyzer": "smartcn" },
      "description": { "type": "text", "analyzer": "smartcn" },
      "categoryId": { "type": "keyword" },
      "status": { "type": "keyword" },
      "price": { "type": "scaled_float", "scaling_factor": 100 },
      "createdAt": { "type": "date" }
    }
  }
}
